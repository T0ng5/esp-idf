{
	"name": "ESP-IDF QEMU",
	"image": "espressif/idf:${imageVariant}",
	"containerEnv": {
		"LC_ALL": "C.UTF-8",
		"ENV LANG": "C.UTF-8"
	},
	"postCreateCommand": {
		"01-Update": "apt-get update -y && apt-get install udev -y",
		"02-Fix-VSCode": "echo \"source /opt/esp/idf/export.sh > /dev/null 2>&1\" >> ~/.bashrc",
		"03-Copy-Fix" : "mkdir -p ~/.espressif/tools && cp .devcontainer/eim_idf.json ~/.espressif/tools/eim_idf.json",
		"04-Create-Main" : "cp -r .devcontainer/blank/* /workspaces/${projectName}",
		"05-update-conf": "echo project(${projectName} >> /workspaces/${projectName}/CMakeList.txt)"
	},
	"postStartCommand": "/opt/esp/entrypoint.sh",
	"customizations": {
		"vscode": {
			"extensions": [
				"espressif.esp-idf-extension",
				"espressif.esp-idf-web"
			],
			"settings": {
			"idf.currentSetup": "/opt/esp/idf"
			}
		}
	},
	"runArgs": ["--privileged"]
}